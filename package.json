{
  "name": "frogpay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
