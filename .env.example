NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Correo local (Mailpit): bandeja web http://localhost:8025
MAIL_PROVIDER=mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FrogPay <no-reply@localhost>"

# PostgreSQL gestionado. Usa un rol de aplicación sin BYPASSRLS.
DATABASE_URL="postgresql://frogpay_app.<PROJECT_REF>:<PASSWORD>@<HOST_POOLER>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://frogpay_app.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres"

# Invitaciones por correo (Resend). MAIL_FROM debe pertenecer a un dominio verificado.
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM="FrogPay <onboarding@tu-dominio-verificado.com>"
FRONTEND_URL=http://localhost:3000

# RabbitMQ local (docker compose)
RABBITMQ_USER=frogpay
RABBITMQ_PASS=replace-with-a-local-password
PRISMA_TX_TIMEOUT_MS=5000
PRISMA_TX_MAX_WAIT_MS=2000
