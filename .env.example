NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3001

# Correo local (Mailpit): bandeja web http://localhost:8025
MAIL_PROVIDER=mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FrogPay <no-reply@localhost>"
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600
# Solo para aprovisionamiento local idempotente mediante `npm run db:seed -w apps/api`.
DEV_PLATFORM_ADMIN_EMAIL=admin@example.test
DEV_PLATFORM_ADMIN_PASSWORD=replace-with-a-local-password-of-at-least-12-characters

# PostgreSQL gestionado. Usa un rol de aplicación sin BYPASSRLS.
DATABASE_URL="postgresql://frogpay_app.<PROJECT_REF>:<PASSWORD>@<HOST_POOLER>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://frogpay_app.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres"

# Produccion: habilitar Resend y usar un dominio verificado.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="FrogPay <onboarding@tu-dominio-verificado.com>"

# Proveedor de pagos (TSK-ARQ/DEV3-203). Un unico secreto compartido para todos
# los tenants este sprint; cuando exista el credencial por tenant, esta variable
# pasa a ser solo el valor por defecto del sandbox. La API no arranca sin ella.
STRIPE_SECRET_KEY=sk_test_replace-with-your-sandbox-secret-key
# Presupuesto duro de cada llamada a Stripe, en milisegundos.
STRIPE_TIMEOUT_MS=3000
# El SDK reintenta 2 veces por defecto; con reintentos el presupuesto real se
# multiplica. 0 deja el timeout como techo de la llamada.
STRIPE_MAX_NETWORK_RETRIES=0
# Metodo de pago -> adaptador (Strategy). Por defecto: card=stripe
# PAYMENT_PROVIDER_BINDINGS=card=stripe
# Solo para pruebas contra un servidor local o stripe-mock:
# STRIPE_API_HOST=127.0.0.1
# STRIPE_API_PORT=12111
# STRIPE_API_PROTOCOL=http

# RabbitMQ local (docker compose)
RABBITMQ_USER=frogpay
RABBITMQ_PASS=replace-with-a-local-password
# El compose establece RABBITMQ_HOST=rabbitmq para la API dentro de Docker.
PRISMA_TX_TIMEOUT_MS=5000
PRISMA_TX_MAX_WAIT_MS=2000
