# Runtime de la app: rol frogpay_app (sin BYPASSRLS), transaction pooler
DATABASE_URL="postgresql://frogpay_app.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
NODE_ENV=development
PORT=4000
PRISMA_TX_TIMEOUT_MS=30000
PRISMA_TX_MAX_WAIT_MS=15000

# QR local
QR_EXPIRATION_MINUTES=15
QR_EXPIRATION_JOB_ENABLED=false
QR_EXPIRATION_JOB_INTERVAL_SECONDS=30
# Simuladores QR habilitados en desarrollo; producción siempre los bloquea.
QR_SIMULATORS_ENABLED=true
# Autoconfirmación: habilítala manualmente fuera de producción si se necesita.
QR_AUTO_CONFIRM_ENABLED=false
QR_AUTO_CONFIRM_SECONDS=10
QR_AUTO_CONFIRM_INTERVAL_SECONDS=2

CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth JWT (Mínimo 32 caracteres)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here
JWT_EXPIRES_IN_SECONDS=3600

# RabbitMQ local
RABBITMQ_USER=frogpay
RABBITMQ_PASS=replace-with-a-local-password

# Redis local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Correo local (Mailpit)
MAIL_PROVIDER=mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FrogPay <no-reply@localhost>"

# Candado de Cifrado AES-256-GCM para Stripe (64 hex chars)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here_generate_with_crypto_randomBytes

# Stripe (sandbox)
STRIPE_SECRET_KEY=sk_test_replace-with-your-sandbox-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Billetera Digital QR (Sprint 3)
QR_EXPIRATION_MINUTES=15
QR_AUTO_CONFIRM_SECONDS=10

# Transferencia Bancaria (Sprint 3 - HU-19, HU-20, HU-21)
BANK_TRANSFER_EXPIRATION_HOURS=24
BANK_AUTO_CONFIRM_SECONDS=

# Webhooks y Resiliencia (Sprint 3)
WEBHOOK_TIMEOUT_MS=3000
WEBHOOK_MAX_RETRIES=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
