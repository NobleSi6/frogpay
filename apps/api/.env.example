# Configuración local del correo de invitación (Mailpit)
MAIL_PROVIDER=mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FrogPay <no-reply@localhost>"
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600

# Auditoría inmutable (retención documental; no elimina filas automáticamente)
AUDIT_RETENTION_YEARS=5
AUDIT_VERIFICATION_JOB_ENABLED=false
AUDIT_VERIFICATION_INTERVAL_SECONDS=86400
# Solo para aprovisionamiento local idempotente mediante `npm run db:seed`.
DEV_PLATFORM_ADMIN_EMAIL=admin@example.test
DEV_PLATFORM_ADMIN_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
DEV_DEMO_OWNER_PASSWORD=replace-with-a-local-demo-password

# Para producción, usar Resend con un dominio verificado:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="FrogPay <invitaciones@tu-dominio.com>"

# PostgreSQL gestionado; utiliza un rol de aplicación que no omita RLS.
DATABASE_URL=postgresql://frogpay_app.<PROJECT_REF>:<PASSWORD>@<HOST_POOLER>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://frogpay_app.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres
PRISMA_TX_TIMEOUT_MS=5000
PRISMA_TX_MAX_WAIT_MS=2000

# Proveedor de pagos (TSK-ARQ/DEV3-203). Obligatoria: la API no arranca sin ella.
# Un unico secreto compartido para todos los tenants este sprint.
STRIPE_SECRET_KEY=sk_test_replace-with-your-sandbox-secret-key
STRIPE_TIMEOUT_MS=3000
STRIPE_MAX_NETWORK_RETRIES=0
# 32-byte key encoded as exactly 64 hexadecimal characters.
CREDENTIALS_ENCRYPTION_KEY=replace_with_64_hex_characters
# Metodo de pago -> adaptador (Strategy). Por defecto: card=stripe
# PAYMENT_PROVIDER_BINDINGS=card=stripe
# Habilita el adapter determinista solo en entornos no productivos (por defecto: false).
PAYMENT_MOCK_ADAPTER_ENABLED=false
# Para simular pagos localmente sin llamar a Stripe, habilita el mock y selecciona:
# PAYMENT_PROVIDER_BINDINGS=card=mock

# QR local (payload simulado EMVCo y expiración)
QR_EXPIRATION_MINUTES=15
QR_EXPIRATION_JOB_ENABLED=false
QR_EXPIRATION_JOB_INTERVAL_SECONDS=30
# Simuladores QR solo en entornos no productivos; producción siempre los bloquea.
QR_SIMULATORS_ENABLED=true
# Autoconfirmación: por defecto desactivada fuera de producción.
QR_AUTO_CONFIRM_ENABLED=false
QR_AUTO_CONFIRM_SECONDS=10
QR_AUTO_CONFIRM_INTERVAL_SECONDS=2

# Para ejecutar la API fuera de Docker; el broker se inicia con docker compose.
RABBITMQ_USER=frogpay
RABBITMQ_PASS=replace-with-the-same-local-password-as-root-env

# Publicador del outbox (TSK-ARQ-205). Por defecto: false fuera de producción,
# true en producción. Déjalo en false si tu instancia local no debe publicar
# los eventos de la BD compartida (ver docs/eventos.md).
OUTBOX_PUBLISHER_ENABLED=false

# Redis (docker compose establece REDIS_HOST=redis dentro del contenedor)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Webhooks salientes (TSK-DEV2-301/302) ----------
WEBHOOK_TIMEOUT_MS=3000
WEBHOOK_WORKER_ENABLED=true

# ---------- Circuit Breaker (TSK-DEV2-304) ----------
CIRCUIT_BREAKER_FAILURE_RATE=0.5
CIRCUIT_BREAKER_WINDOW_MS=60000
CIRCUIT_BREAKER_MIN_REQUESTS=5
CIRCUIT_BREAKER_OPEN_MS=30000

# ---------- Reintentos de pagos asíncronos (TSK-DEV2-305) ----------
PROVIDER_RETRY_DELAYS_MS=5000,10000,20000,40000,80000
PROVIDER_RETRY_WORKER_ENABLED=true
