# Safe local defaults. Do not place backend secrets in this file.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Grafana del perfil de observabilidad local.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002
# Set true only for the explicit offline demo fallback.
NEXT_PUBLIC_DEMO_MODE=false
# Solo desarrollo: "true" usa el simulador local de transacciones para
# GET /dashboard/payments. Cualquier otro valor (o un build de producción)
# llama a la API real. En producción debe ser "false".
NEXT_PUBLIC_USE_MOCKS=false
# Clave publicable de Stripe usada por el CardElement del checkout (pk_test_… en sandbox).
# La clave secreta NO va aquí: se guarda cifrada por tenant desde
# /dashboard/configuracion/proveedores/stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
