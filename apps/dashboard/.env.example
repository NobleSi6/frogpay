# Sprint 1 runs in centralized mock demo mode even if these future integration values exist.
# Include the /api prefix only when demo mode is intentionally disabled in a later sprint.
NEXT_PUBLIC_API_URL=
# Example: http://localhost:4000/api
# Explicit local integration only; ignored by production builds.
# Backend must run in development. This is NOT user authentication.
NEXT_PUBLIC_API_DEV_MODE=false
# Existing tenant UUID used for local admin API-key testing; no secrets.
NEXT_PUBLIC_API_DEV_TENANT_ID=
